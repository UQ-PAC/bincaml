; checks tree-sitter is valid and unambiguous

(rule
 (deps grammar.js)
 (alias runtest)
 (enabled_if %{bin-available:tree-sitter})
 (action
  (run tree-sitter generate grammar.js)))

; check that grammar.js is up to date.
; requires `bnfc-treesitter` from pac-nix.

(rule
 (alias runtest)
 (deps %{project_root}/lib/fe/BasilIR.cf)
 (enabled_if %{bin-available:bnfc})
 (action
  (progn
   (copy %{deps} basilir.cf)
   (run
    bnfc
    --tree-sitter
    --tree-sitter-word
    LocalIdent
    basilir.cf
    --makefile)
   (diff? grammar.js tree-sitter-basilir/grammar.js))))
