{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "basilir",
      "camelcase": "BasilIR",
      "title": "Basil IR",
      "scope": "source.basilir",
      "file-types": [
        "il"
      ],
      "injection-regex": "^basilir$",
      "class-name": "TreeSitterBasilir"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Basilir grammar for tree-sitter",
    "authors": [
      {
        "name": "UQ PAC"
      }
    ],
    "links": {
      "repository": "https://github.com/tree-sitter/tree-sitter-basilir"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}