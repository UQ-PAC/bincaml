#!/usr/bin/env bash

set -eu

project_root="$1"
runmake="${project_root}/test/compile/runmake"

for ext in exe gtirb il; do
  echo "(alias (name $ext) (deps (glob_files *.$ext)))"
done
echo

for f in *.c; do
  base="$(basename "$f" .c)"

  tail="(enabled_if %{file-available:$runmake}) (action (run $runmake %{targets})))"

  echo "(rule (targets $base.exe) (deps $base.c) $tail"
  echo "(rule (targets $base.gtirb) (deps $base.exe) $tail"
  echo "(rule (targets $base.il) (deps $base.gtirb) (mode promote) $tail"
  echo
done
