(load-il "repeated_ssa.il")
(run-transforms "ssa")
(dump-il "ssa-0.il")
(run-transforms "ssa")
(dump-il "ssa-1.il")

(load-il "repeated_ssa.il")
(run-transforms "ssa")
(dump-il "repeated-0.il")
(run-transforms "reconstruct-ssa")
(dump-il "repeated-1.il")
(run-transforms "reconstruct-ssa")
(dump-il "repeated-2.il")
