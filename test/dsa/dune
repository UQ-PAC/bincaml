(include dune.inc)

(rule
 (deps (glob_files *.c))
 (action
(with-stdout-to
  dune.inc.new
  (run %{project_root}/test/compile/makedune %{project_root}))))

(rule
 (alias runtest)
 (action
  (diff dune.inc dune.inc.new)))

