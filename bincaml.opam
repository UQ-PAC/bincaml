maintainer: ["Maintainer Name <maintainer@example.com>"]
authors: ["Author Name <author@example.com>"]
license: "Apache-2.0"
tags: ["program-analysis"]
homepage: "https://github.com/username/reponame"
doc: "https://url/to/documentation"
bug-reports: "https://github.com/username/reponame/issues"
depends: [
  "dune" {>= "3.19"}
  "ocaml"
  "aslp_lifter_ocaml" {>= "1.1"}
  "ocaml-protoc-plugin" {>= "6.1.0"}
  "qcheck-stm" {with-test}
  "qcheck-core" {with-test}
  "qcheck-alcotest" {with-test}
  "menhir" {>= "20180523"}
  "angstrom"
  "zarith"
  "fix"
  "trace"
  "trace-tef"
  "containers"
  "iter"
  "containers-data"
  "ppx_deriving"
  "ocamlgraph"
  "cmdliner" {>= "2.0.0"}
  "pp_loc"
  "fmt"
  "patricia-tree"
  "ppx_here"
  "intPQueue"
  "logs"
  "mtime"
  "linenoise"
  "stb_image"
  "kittyimg"
  "terminal_size"
  "ocamlformat" {with-dev-setup}
  "odig" {with-dev-setup}
  "sherlodoc" {with-doc}
  "ppx_expect"
  "alcotest" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/username/reponame.git"
x-maintenance-intent: ["(latest)"]
depexts: [
  ["capstone-devel"] {os-family = "fedora"}
  ["capstone-dev"] {os-distribution = "alpine"}
  ["libcapstone-dev"] {os-family = "debian" | os-family = "ubuntu"}
  ["capstone"] {os = "macos" & os-distribution = "macports"}
  ["capstone"] {os = "macos" & os-distribution = "homebrew"}
  ["capstone"] {os = "freebsd"}
  ["capstone"] {os-distribution = "nixos"}
]
