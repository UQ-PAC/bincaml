; list of warnings: https://ocaml.org/manual/5.1/toplevel.html#:~:text=The%20warnings%20are%20as%20follows

(env
 ; in dev, all warnings are non-fatal.
 (dev
  (flags
   (:standard
    -warn-error
    -A
    -w
    -unused-var-strict
    -w
    -missing-record-field-pattern
    -w
    -unused-open)))
 ; in release, all (enabled) warnings are fatal.
 (release
  (flags
   (:standard -warn-error A))))
